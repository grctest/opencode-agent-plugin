    "@opencode-ai/sdk": "^1.18.16",
    "esbuild": "^0.28.2",
    "marked": "^18.0.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "dompurify": "^3.4.13",
