{
  "name": "loom",
  "version": "0.1.0",
  "description": "Multi-agent deliberation protocol for opencode — a knitting machine for AI agents",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "bundle": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "node --check dist/loom.js",
    "install:plugin": "node scripts/install.mjs",
    "update:plugin": "node scripts/update.mjs"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.15",
    "@opencode-ai/sdk": "^1.18.15"
  },
  "devDependencies": {
    "@esbuild/linux-x64": "^0.28.2",
    "@opencode-ai/plugin": "^1.18.14",
    "@opencode-ai/sdk": "^1.18.14",
    "esbuild": "^0.28.2",
    "marked": "^18.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.5.1": true,
    "msgpackr-extract@3.0.4": true
  },
  "dependencies": {
    "purecss": "^3.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
