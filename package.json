{
  "name": "loom",
  "version": "0.1.0",
  "description": "Multi-agent deliberation protocol for opencode — a knitting machine for AI agents",
  "type": "module",
  "main": "dist/loom.js",
  "scripts": {
    "bundle": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "check": "node --check src/index.js && node --check src/orchestrator.js && node --check src/round-executor.js && node --check src/database.js && node --check src/handlers/knit-handler.js && node --check src/config.js && node --check dist/loom.js",
    "install:plugin": "npm run bundle && node scripts/install.mjs",
    "update:plugin": "node scripts/update.mjs",
    "model:download": "node scripts/model.mjs download"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.15",
    "@opencode-ai/sdk": "^1.18.15"
  },
  "devDependencies": {
    "@esbuild/linux-x64": "^0.28.2",
    "@opencode-ai/plugin": "^1.18.16",
    "@opencode-ai/sdk": "^1.18.16",
    "esbuild": "^0.28.2",
    "marked": "^18.0.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true,
    "onnxruntime-node@1.27.0": true
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.1.3",
    "dompurify": "^3.4.13",
    "onnxruntime-node": "^1.27.0",
    "purecss": "^3.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-window": "^2.3.0",
    "sqlite-vec": "^0.1.9"
  }
}
