{
  "name": "loom",
  "version": "0.1.0",
  "description": "Multi-agent deliberation protocol for opencode — a knitting machine for AI agents",
  "type": "module",
  "main": "dist/loom.js",
  "license": "MIT",
  "author": "The Loom Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loom-dev/loom.git"
  },
  "files": [
    "dist",
    "src",
    "personas",
    "commands",
    "scripts",
    "README.md",
    "ORCHESTRATION_ARCHITECTURE.md"
  ],
  "engines": {
    "node": ">=18",
    "bun": ">=1.1.0"
  },
  "scripts": {
    "prepack": "npm run check && npm run bundle",
    "test": "node --test test",
    "bundle": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "check": "node scripts/check.mjs",
    "install:plugin": "npm run bundle && node scripts/install.mjs",
    "update:plugin": "npm run bundle && node scripts/update.mjs",
    "model:download": "node scripts/model.mjs download",
    "uninstall:plugin": "node scripts/uninstall.mjs"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.16",
    "@opencode-ai/sdk": "^1.18.16"
  },
  "devDependencies": {
    "@esbuild/linux-x64": "^0.28.2",
    "@opencode-ai/plugin": "^1.18.32",
    "@opencode-ai/sdk": "^1.18.32",
    "@tailwindcss/postcss": "^4.3.3",
    "esbuild": "^0.28.2",
    "marked": "^18.0.14",
    "postcss": "^8.5.28",
    "shadcn": "^4.19.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true,
    "onnxruntime-node@1.30.0": true
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@huggingface/tokenizers": "^0.2.0",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/react": "^2.0.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.15",
    "embla-carousel-react": "^8.6.0",
    "fuse.js": "^7.5.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.34.0",
    "nanostores": "^1.5.3",
    "onnxruntime-node": "^1.30.0",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "react-window": "^2.3.2",
    "recharts": "^3.8.0",
    "sqlite-vec": "^0.1.9",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.1.8"
  }
}
