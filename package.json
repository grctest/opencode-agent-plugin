{
  "name": "loom",
  "version": "0.1.0",
  "description": "Multi-agent deliberation protocol for opencode — a knitting machine for AI agents",
  "type": "module",
  "main": "dist/loom.js",
  "license": "MIT",
  "author": "The Loom Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loom-dev/loom.git"
  },
  "files": [
    "dist",
    "personas",
    "commands",
    "scripts",
    "README.md",
    "ORCHESTRATION_ARCHITECTURE.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "bundle": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "check": "node scripts/check.mjs",
    "install:plugin": "npm run bundle && node scripts/install.mjs",
    "update:plugin": "npm run bundle && node scripts/update.mjs",
    "model:download": "node scripts/model.mjs download",
    "uninstall:plugin": "node scripts/uninstall.mjs"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.16",
    "@opencode-ai/sdk": "^1.18.16"
  },
  "devDependencies": {
    "@esbuild/linux-x64": "^0.28.2",
    "@opencode-ai/plugin": "^1.18.16",
    "@opencode-ai/sdk": "^1.18.16",
    "esbuild": "^0.28.2",
    "marked": "^18.0.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true,
    "onnxruntime-node@1.27.0": true
  },
  "dependencies": {
    "@huggingface/tokenizers": "^0.1.3",
    "dompurify": "^3.4.13",
    "onnxruntime-node": "^1.27.0",
    "purecss": "^3.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-window": "^2.3.0",
    "sqlite-vec": "^0.1.9"
  }
}
